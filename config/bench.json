{
  "_comment": "Bench mock-up (toy car). Copy this file per site; code stays the same.",
  "camera": {
    "source": 1,
    "resize": null
  },
  "model": {
    "path": "roboflow/tire_model.pt",
    "conf": 0.5,
    "imgsz": 640,
    "device": null,
    "front_class": "tire_front_driver",
    "rear_class": "tire_rear_driver",
    "crop": {
      "type": "red_car",
